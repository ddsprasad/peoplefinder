# =============================================================================
# peopleFinder configuration  --  copy this file to ".env" and fill in values.
#   PowerShell:  Copy-Item .env.example .env
# Never commit the real .env (it is git-ignored).
# =============================================================================

# ---------- SQL Server (SQL login / username + password) ---------------------
DB_SERVER=your-sql-server.database.windows.net
DB_DATABASE=your_database
DB_USERNAME=your_sql_user
DB_PASSWORD=your_sql_password
# ODBC driver installed on this machine. Common: "ODBC Driver 18 for SQL Server"
DB_DRIVER=ODBC Driver 18 for SQL Server
# Driver 18 encrypts by default. Set as needed for your server.
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no

# ---------- Azure AI Search --------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your_admin_api_key
AZURE_SEARCH_INDEX=datalake-files

# ---------- Master sheet (employee audit source) -----------------------------
MASTER_XLSX_PATH=G:\Zach\Databases\OneDrive_2026-05-18\ITR_-_Work_&_Home_Address_Audit April 2026.xlsx
MASTER_SHEET_NAME=ITR - Work & Home Address Audit

# ---------- Tuning (optional) ------------------------------------------------
# Characters per Azure Search document chunk (large files are split).
MAX_CHUNK_CHARS=32000
# Concurrent worker threads for the audit search phase.
AUDIT_WORKERS=8
# Output directory for generated CSVs.
OUTPUT_DIR=output
